# Environment variables for ATEM Director

# Application environment (development, staging, production)
ENV=development
DEBUG=false

# ATEM Device Configuration
ATEM_HOST=192.168.1.100
ATEM_PORT=21124
ATEM_CONNECTION_TIMEOUT=5.0
ATEM_RECONNECT_ATTEMPTS=3
ATEM_RECONNECT_DELAY=2.0

# Database Configuration
DATABASE_URL=postgresql+asyncpg://atem_user:atem_password@localhost/atem_director
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1
API_LOG_LEVEL=info
API_CORS_ORIGINS=["*"]

# Authentication Configuration
AUTH_SECRET_KEY=your-secret-key-change-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
